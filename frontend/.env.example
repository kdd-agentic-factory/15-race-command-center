# Race AI Copilot URL (16 backend)
# If not set, fallback mock is used
VITE_RACE_AI_COPILOT_URL=

# Race Command Center URL (used by 13 to point to 15)
# Default: /command-center (same-origin proxy)
VITE_RACE_COMMAND_CENTER_URL=

# Preview mode: skip auth prompts, all routes render
# Set to true for demo / product preview
VITE_RCC_PREVIEW_MODE=true
